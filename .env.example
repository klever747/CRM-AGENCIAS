# Copy this file to .env on the VPS and fill in real values.
# Never commit the real .env file.

# Postgres connection string (Supabase or any Postgres instance).
# Rotate the Supabase password before using this in production —
# it was previously hardcoded in the repo history.
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.jhdvsnpxypszwslhsivg.supabase.co:5432/postgres

NODE_ENV=production

# The app listens on 3000 inside the container (hardcoded in server.ts).
# The external port (8799) is set in docker-compose.yml's "ports" mapping,
# not here. If you apply the server.ts PORT patch from DEPLOY.md, you can
# also set PORT=3000 here to make the internal port configurable.
